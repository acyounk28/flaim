# Copy to .env next to docker-compose.yml. Never commit .env.

# ---- flaim-mcp (Node gateway: ESPN / Sleeper / Yahoo league tools) ----------
# Bearer token Poke sends as "Authorization: Bearer ...". >= 24 chars.
#   openssl rand -hex 32
FLAIM_MCP_TOKEN=

# ESPN private-league cookies (copy from a logged-in espn.com session).
# Both are needed for ESPN tools; leave blank for Sleeper-only setups. Missing
# cookies only disable ESPN tools, the server still starts. SWID / espn_s2 are
# accepted as aliases (same names as pi-homelab-setup).
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Leagues. Comma-separated IDs; optionally "leagueId:teamId" (ESPN) or
# "leagueId:rosterId" (Sleeper). Sport defaults to football and the season to
# the current one (override with ESPN_SPORT / ESPN_SEASON_YEAR, SLEEPER_SPORT /
# SLEEPER_SEASON_YEAR). config/leagues.json is optional and adds names/team ids.
ESPN_LEAGUE_IDS=
SLEEPER_LEAGUE_IDS=
SLEEPER_USERNAME=

# Optional: token shared between the in-process services. Auto-generated if empty.
INTERNAL_SERVICE_TOKEN=

# ---- nfl-metrics (Python FastMCP: nflverse metrics + GM tools) --------------
#   openssl rand -hex 32
NFL_MCP_TOKEN=
# sse (default, what Poke expects at /sse) or streamable-http (served at /mcp)
NFL_MCP_TRANSPORT=sse
# Re-download current-season play-by-play after this many hours (completed seasons never expire)
NFL_RAW_TTL_HOURS=12
# Recompute cached aggregates for the current season after this many hours
NFL_DERIVED_TTL_HOURS=6
# Seasons kept as in-memory LazyFrame handles; keep at 1 on a Pi
NFL_MAX_SEASONS_IN_MEMORY=1
# Polars worker threads (Pi 5 has 4 cores; leave one for the OS/tunnel)
POLARS_MAX_THREADS=3

# ---- host binding / ports -----------------------------------------------------
# Loopback only by default; the tunnel talks to the containers over the compose network.
FLAIM_BIND=127.0.0.1
FLAIM_PORT=8790
NFL_PORT=8800
FLAIM_MEM_LIMIT=512m
NFL_MEM_LIMIT=1536m

# ---- cloudflared (docker compose --profile tunnel up -d) ----------------------
# Zero Trust > Networks > Tunnels > your tunnel > "Install connector" token
CLOUDFLARE_TUNNEL_TOKEN=
